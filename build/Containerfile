# syntax=docker/dockerfile:1
# Build context: src/

FROM docker.io/library/golang:1.26-bookworm AS build
WORKDIR /src
COPY go.mod go.sum ./
COPY cmd ./cmd
COPY internal ./internal
ENV CGO_ENABLED=0 GOOS=linux GOARCH=amd64 GOFLAGS=-buildvcs=false
RUN go mod tidy \
  && go build -ldflags="-s -w" -o /out/matchmedia ./cmd

FROM docker.io/library/debian:trixie-slim
WORKDIR /dist
COPY --from=build /out/matchmedia /dist/.local/bin/matchmedia
COPY share/config /dist/.local/share/matchmedia/config
COPY webui/index.html webui/style.css webui/app.js /dist/.local/share/matchmedia/public/

CMD ["sh", "-c", "cp -a /dist/. /out/ && chmod -R a+rX /out && chmod a+x /out/.local/bin/matchmedia"]
